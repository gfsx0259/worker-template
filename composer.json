{
    "name": "enthusiast/worker-template",
    "description": "Base worker parts",
    "type": "library",
    "require": {
        "php": "^8.4",
        "ext-pcntl": "*",
        "ext-redis": "*",
        "ext-rdkafka": "*",
        "open-telemetry/sdk": "^1.14",
        "enqueue/rdkafka": "^0.10.27",
        "yiisoft/yii-console": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Enthusiast\\WorkerTemplate\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Konstantin Popov",
            "email": "konstantin.icreative@gmail.com"
        }
    ],
    "extra": {
        "config-plugin-options": {
            "source-directory": "config"
        },
        "config-plugin": {
            "di": "common.php",
            "params": "params.php"
        }
    },
    "minimum-stability": "stable",
    "config": {
        "allow-plugins": {
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    }
}
